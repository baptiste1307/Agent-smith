# ==============================================================================
# Agent Smith - Configuration d'exemple (.env.example)
#
# Copiez ce fichier vers .env :
#   cp .env.example .env
#   (ou dans le dossier student/ : cp .env.example student/.env)
#
# IMPORTANT:
# - Ne committez JAMAIS vos véritables clés privées sur Git.
# - Le sujet impose le multi-token management : vous pouvez spécifier plusieurs
#   clés par provider séparées par des virgules pour permettre la rotation en
#   cas de limite de taux (HTTP 429) ou d'épuisement de quota (HTTP 402).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Fournisseurs LLM (Free-tier API Keys)
# ------------------------------------------------------------------------------

# OpenRouter (supporte plusieurs clés séparées par des virgules)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxx,sk-or-v1-yyyyyyyyyyyy

# Mistral AI
MISTRAL_API_KEY=your_mistral_api_key_here

# Groq
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx

# Together AI
TOGETHER_API_KEY=your_together_api_key_here

# Google Gemini / AI Studio
GEMINI_API_KEY=your_gemini_api_key_here

# Fournisseur générique de secours
# LLM_API_KEY=your_generic_api_key_here

# ------------------------------------------------------------------------------
# 2. Paramètres de l'Agent & Modèles par défaut
# ------------------------------------------------------------------------------

# Les modèles par défaut (principal + secours) sont définis dans
# student/models_config.json, section "default_benchmarks".
# Pour en forcer un autre : --model-name MODEL --provider-url URL

# ------------------------------------------------------------------------------
# 3. Environnement de Testbed & SWE-bench (Optionnel pour tests locaux)
# ------------------------------------------------------------------------------

# Chemin local vers le dépôt cible (si non défini, le conteneur Docker SWE-bench
# est automatiquement démarré pour extraire et tester /testbed)
# TESTBED_PATH=/absolute/path/to/local/repository

# Script d'évaluation optionnel injecté si absent de la tâche
# EVAL_SCRIPT_PATH=/path/to/eval.sh

